#
# Copy to `.env` or `.env.local` and fill in your database connection string.
#
# Supabase Database (use Transaction pooler for serverless/ORM)
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:5432/postgres?pgbouncer=true
SUPABASE_DB_URL=

# Optional (for migrations): use direct connection instead of pooler
# DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# Supabase Project API
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: use Supabase JWT secret for backend token signing/verification
SUPABASE_JWT_SECRET=

# Optional custom JWT secret (takes priority over SUPABASE_JWT_SECRET)
JWT_SECRET=

# Frontend -> backend target when running on phone (LAN IP of your PC)
EXPO_PUBLIC_DOMAIN=192.168.x.x:5000

